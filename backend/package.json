{
  "name": "gym-platform-api",
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node build/server.js",
    "build": "tsup src/server.ts --out-dir build --format esm --clean",
    "lint": "eslint src prisma scripts --ext .ts",
    "lint:fix": "eslint src prisma scripts --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:e2e": "vitest run --project e2e",
    "test:e2e:watch": "vitest --project e2e",
    "test:coverage": "vitest run --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "gyms:import": "tsx scripts/import-gyms.ts",
    "render:build": "npm ci --include=dev && npm run build && npm run db:deploy"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [],
  "author": "Gustavo Santana",
  "license": "ISC",
  "description": "Full-featured RESTful API for a GymPass-style application, including user authentication, gym management, check-ins with location validation, and daily usage tracking.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gustavosantana-034/GYM-API.git"
  },
  "homepage": "https://github.com/gustavosantana-034/GYM-API#readme",
  "devDependencies": {
    "@rocketseat/eslint-config": "2.2.2",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "24.1.0",
    "@types/supertest": "6.0.3",
    "@vitest/coverage-v8": "3.2.4",
    "@vitest/ui": "3.2.4",
    "eslint": "8.57.1",
    "prisma": "6.13.0",
    "supertest": "7.1.4",
    "tsup": "8.5.0",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/cors": "11.1.0",
    "@fastify/jwt": "9.1.0",
    "@prisma/client": "6.13.0",
    "bcryptjs": "3.0.2",
    "dayjs": "1.11.13",
    "dotenv": "17.2.0",
    "fastify": "5.4.0",
    "ts-custom-error": "3.3.1",
    "zod": "4.0.5"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  }
}
